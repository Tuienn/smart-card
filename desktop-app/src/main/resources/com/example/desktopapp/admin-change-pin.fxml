<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.desktopapp.controller.AdminChangePinController"
            styleClass="root">
    
    <top>
        <HBox>
            <padding>
                <Insets top="20" right="20" bottom="0" left="20"/>
            </padding>
            <Button text="🏠" onAction="#onBackToHome" styleClass="btn-back" style="-fx-min-width: 50; -fx-min-height: 50; -fx-background-radius: 50; -fx-border-radius: 50; -fx-font-size: 20px;">
                <Tooltip text="Về trang chủ Admin"/>
            </Button>
        </HBox>
    </top>
    
    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true" style="-fx-background: transparent; -fx-background-color: transparent;">
            <VBox alignment="TOP_CENTER" spacing="15" styleClass="main-container">
                <padding>
                    <Insets top="20" right="20" bottom="20" left="20"/>
                </padding>

            <!-- Header -->
            <VBox alignment="CENTER" spacing="10">
                <StackPane styleClass="main-icon-container" style="-fx-min-width: 80; -fx-min-height: 80; -fx-max-width: 80; -fx-max-height: 80;">
                    <Label text="🔑" style="-fx-font-size: 40px;"/>
                </StackPane>
                <Label text="ĐỔI MẬT KHẨU THẺ" styleClass="title-large" style="-fx-font-size: 28px;"/>
                <Label text="Thay đổi PIN cho thẻ người dùng" styleClass="subtitle"/>
            </VBox>

            <!-- Content -->
            <VBox spacing="20" alignment="CENTER" style="-fx-max-width: 600;">
                
                <!-- Step Indicator -->
                <HBox spacing="15" alignment="CENTER">
                    <VBox alignment="CENTER" spacing="5">
                        <StackPane fx:id="step1Circle" styleClass="step-circle-active" style="-fx-min-width: 40; -fx-min-height: 40;">
                            <Label text="1" style="-fx-text-fill: white; -fx-font-weight: bold;"/>
                        </StackPane>
                        <Label text="Đặt thẻ" styleClass="step-label"/>
                    </VBox>
                    <Label text="➜" style="-fx-font-size: 24px; -fx-text-fill: rgba(99, 102, 241, 0.5); -fx-padding: 0 10 0 10;"/>
                    <VBox alignment="CENTER" spacing="5">
                        <StackPane fx:id="step2Circle" styleClass="step-circle" style="-fx-min-width: 40; -fx-min-height: 40;">
                            <Label text="2" style="-fx-text-fill: white; -fx-font-weight: bold;"/>
                        </StackPane>
                        <Label text="Admin PIN" styleClass="step-label"/>
                    </VBox>
                    <Label text="➜" style="-fx-font-size: 24px; -fx-text-fill: rgba(99, 102, 241, 0.5); -fx-padding: 0 10 0 10;"/>
                    <VBox alignment="CENTER" spacing="5">
                        <StackPane fx:id="step3Circle" styleClass="step-circle" style="-fx-min-width: 40; -fx-min-height: 40;">
                            <Label text="3" style="-fx-text-fill: white; -fx-font-weight: bold;"/>
                        </StackPane>
                        <Label text="Đổi PIN" styleClass="step-label"/>
                    </VBox>
                </HBox>

                <!-- Step 1: Card Check -->
                <VBox fx:id="step1Content" spacing="15" alignment="CENTER" styleClass="glass-panel" style="-fx-padding: 30;">
                    <Label text="📇" style="-fx-font-size: 60px;"/>
                    <Label text="Đặt thẻ vào đầu đọc" styleClass="title-small"/>
                    <Label fx:id="cardStatusLabel" text="Nhấn nút bên dưới để kiểm tra thẻ" styleClass="subtitle" textAlignment="CENTER" wrapText="true"/>
                    <Button text="🔍 Kiểm tra thẻ" onAction="#onCheckCard" styleClass="btn-primary" style="-fx-min-width: 200; -fx-pref-height: 45; -fx-font-size: 16px;">
                    </Button>
                </VBox>

                <!-- Step 2: Admin PIN -->
                <VBox fx:id="step2Content" spacing="15" alignment="CENTER" styleClass="glass-panel" style="-fx-padding: 30;" visible="false" managed="false">
                    <Label text="Nhập Admin PIN" styleClass="title-small"/>
                    <Label text="Xác thực quyền quản trị" styleClass="subtitle"/>
                    
                    <PasswordField fx:id="adminPinField" promptText="Nhập Admin PIN" 
                                  style="-fx-min-width: 300; -fx-pref-height: 40; -fx-font-size: 16px;"/>
                    
                    <Button text="✓ Xác thực" onAction="#onVerifyAdminPin" styleClass="btn-primary" style="-fx-min-width: 200; -fx-pref-height: 45; -fx-font-size: 16px;">
                    </Button>
                    
                    <Label fx:id="adminPinErrorLabel" text="" styleClass="error-label" visible="false"/>
                </VBox>

                <!-- Step 3: Change PIN -->
                <VBox fx:id="step3Content" spacing="15" alignment="CENTER" styleClass="glass-panel" style="-fx-padding: 30;" visible="false" managed="false">
                    <Label text="🔑" style="-fx-font-size: 60px;"/>
                    <Label text="Nhập PIN mới cho thẻ" styleClass="title-small"/>
                    
                    <VBox spacing="10" style="-fx-max-width: 350;">
                        <Label text="PIN mới (6 số):" style="-fx-font-size: 14px;"/>
                        <PasswordField fx:id="newPinField" promptText="Nhập 6 số PIN mới" 
                                      style="-fx-pref-height: 40; -fx-font-size: 16px;"/>
                        
                        <Label text="Xác nhận PIN mới:" style="-fx-font-size: 14px;"/>
                        <PasswordField fx:id="confirmPinField" promptText="Nhập lại PIN mới" 
                                      style="-fx-pref-height: 40; -fx-font-size: 16px;"/>
                    </VBox>
                    
                    <Button text="✓ Đổi mật khẩu" onAction="#onChangePin" styleClass="btn-success" style="-fx-min-width: 200; -fx-pref-height: 45; -fx-font-size: 16px;">
                    </Button>
                    
                    <ProgressIndicator fx:id="changeProgress" visible="false" style="-fx-max-width: 50; -fx-max-height: 50;"/>
                    <Label fx:id="changeStatusLabel" text="" styleClass="subtitle" visible="false"/>
                </VBox>

            </VBox>

            <!-- Back Button -->
            <Button text="← Quay lại" onAction="#onBack" styleClass="btn-secondary" style="-fx-min-width: 150;">
            </Button>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
